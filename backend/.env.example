PROJECT_NAME="AI Digital Twin System for Software Intelligence"
API_V1_STR=/api/v1
ENVIRONMENT=development
DEBUG=True
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=software_digital_twin
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/software_digital_twin

# Phase 7: AI Project Assistant (Groq & Infinity Chat / Multi-Provider Configuration)
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
AI_STREAMING=true
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2048

# Fallback Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=60.0
OLLAMA_TEMPERATURE=0.2
