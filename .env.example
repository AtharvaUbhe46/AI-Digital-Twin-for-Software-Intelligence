# Environment Configuration for AI Digital Twin System for Software Intelligence

# App
PROJECT_NAME="AI Digital Twin for Software Intelligence"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=software_digital_twin
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/software_digital_twin

# Future Phase Placeholders (Scaffolded for Phase 2+)
# GITHUB_ACCESS_TOKEN=
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password
# LLM_API_KEY=

# Phase 4: Software Health & Risk Detection Configuration
HEALTH_RECENT_DAYS=30
HEALTH_STALE_ISSUE_DAYS=30
HEALTH_STALE_PR_DAYS=14
HEALTH_ACTIVITY_WEIGHT=0.20
HEALTH_ISSUE_WEIGHT=0.20
HEALTH_PR_WEIGHT=0.20
HEALTH_CONTRIBUTOR_WEIGHT=0.15
HEALTH_RELEASE_WEIGHT=0.10
HEALTH_MAINTENANCE_WEIGHT=0.15

RISK_INACTIVITY_DAYS=14
RISK_STALE_ISSUE_DAYS=30
RISK_STALE_PR_DAYS=14
RISK_BACKLOG_WINDOW_DAYS=30
RISK_ISSUE_BACKLOG_THRESHOLD=5
RISK_PR_BACKLOG_THRESHOLD=3
RISK_CONTRIBUTOR_CONCENTRATION_THRESHOLD=0.65
RISK_RELEASE_STAGNATION_DAYS=90
RISK_ACTIVITY_SPIKE_MULTIPLIER=3.0
