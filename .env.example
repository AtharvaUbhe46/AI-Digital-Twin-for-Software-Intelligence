# Environment Configuration for AI Digital Twin System for Software Intelligence

# App
PROJECT_NAME="AI Digital Twin for Software Intelligence"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=software_digital_twin
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/software_digital_twin

